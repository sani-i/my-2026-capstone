# Copy this file to .env and replace the placeholders with your own values.
# Never commit the filled-in .env file.
PORT=3000
DATABASE_PATH=data/ticketing.db

# Must be at least 16 characters and different from TICKET_SECRET.
AUTH_SECRET=replace-with-a-long-random-login-secret

# Separate key for signed QR ticket codes; at least 16 characters.
TICKET_SECRET=replace-with-a-different-long-random-ticket-secret
